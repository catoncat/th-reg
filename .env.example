# ==== 注册身份：你自己的 catch-all 收件域名（必填其一）====

# 方式 A：固定池 —— 一组已知可 catch-all 收件的域名（逗号分隔，round-robin）
# TH_FIXED_POOL=mail.example.com,mail2.example.net

# 方式 B：动态母域 —— 批量超出固定池时，自动在这组母域下建新子域并接入收件。
# 需要 Cloudflare Email Routing + 你的 CF 凭据（envchain，CF_ENVCHAIN_SCOPE）。
# TH_DYNAMIC_ZONES=example.com

# 方式 C：单域（--domain-mode single）
# TH_DOMAIN=mail.example.com

# 邀请码（选填；省略则注册不带推荐人）
# TH_INVITE_CODE=

# ==== 邮箱验证 provider ====
# none       —— 默认。注册后 tokenharbor 会自动确认邮箱（Supabase email_confirmed_at
#               秒级写入，实测直连/代理均不发验证邮件）。无需任何邮箱收信。
# cloud-mail —— 额外轮询一个邮箱 CLI 拿验证链接，仅在账号未被 auto-confirm 时兜底触发。
#               要求该 CLI 支持 `messages --email <addr> --limit N` 并输出
#               { items:[{ id, text_body, html_body, subject }] }。
# TH_MAIL_MODE=none
# MAILBOX_CLI=cloud-mail

# ==== 出网：默认直连 ====
# direct（默认，用本机 IP）/ sticky（每账号独立的 DataImpulse 住宅 sticky IP）
#       / rotate（轮换 IP，仅用于预检）
# TH_PROXY_MODE=direct
# DataImpulse 凭据（仅 proxy 模式需要）：
# DIP_USERNAME=
# DIP_PASSWORD=
# DIP_HOST=gw.dataimpulse.com
# DIP_ROTATE_PORT=823
# DIP_COUNTRY=us

# ==== 批量行为 ====
# TH_COUNT=1
# TH_DELAY_MS=8000
# TH_WORKERS=1
# TH_DOMAIN_MODE=dynamic
# TH_DOMAIN_MAX_REUSE=2
# TH_TIMEZONE=Asia/Shanghai  # 提交给注册表单的时区

# ==== 邮箱兜底轮询（仅 cloud-mail 模式用）====
# TH_MAIL_TIMEOUT=150
# TH_MAIL_POLL_INTERVAL=5

# ==== 输出 ====
# TH_ACCOUNTS_FILE=data/accounts.jsonl

# ==== 运维层(可选,见 docs/operations.md)====
# 默认路径在 ~/.pi/agent/... 本机集成,可按需覆盖:
# TH_SECRETS_DIR=            # 密钥存放目录
# TH_CURRENT_KEY_FILE=       # 当前生效 key 指针文件
# TH_STATE_DIR=              # 池/网关状态目录
# TH_PLIST_PATH=             # launchd plist 路径(macOS)
# TH_SUPPLY_SERVICE=         # launchd 服务名
# TH_SUPPLY_TARGET=200       # 池目标金额(USD)
# TH_SUPPLY_LOW_WATERMARK=1.0  # 当前 key 低于此值才换