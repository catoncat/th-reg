# Catch-all mailbox domain routed to the cloud-mail intake worker
# (generate local parts like th-<random>@<domain>)
TH_DOMAIN=dogfood.0day3.com

# Mailbox CLI: must accept `messages --email <addr> --limit N` and print
# { items: [{ id, received_at, text_body, html_body, subject }] } on stdout.
# The cloud-mail wrapper already satisfies this contract.
MAILBOX_CLI=cloud-mail

# DataImpulse residential proxy credentials. Leave empty to read from
# ~/.agents/skills/residential-proxy/.secrets/dataimpulse.env
# (or the legacy ~/.pi/... path if the .agents one is missing).
DIP_USERNAME=
DIP_PASSWORD=
DIP_HOST=gw.dataimpulse.com
# Rotating endpoint port (HTTP). Sticky ports 10000-20000 are used per account.
DIP_ROTATE_PORT=823

# Proxy country for sticky sessions (DataImpulse __cc param). Empty = pool default.
DIP_COUNTRY=us

# Registration batch behavior
TH_COUNT=1
TH_DELAY_MS=8000
TH_WORKERS=1
# Seconds to wait for the signup to land on /dashboard
TH_SIGNUP_TIMEOUT=40
# Seconds to poll the mailbox for the verify email
TH_MAIL_TIMEOUT=150
# Seconds between mailbox polls
TH_MAIL_POLL_INTERVAL=5

# Output path for created accounts (JSONL)
TH_ACCOUNTS_FILE=data/accounts.jsonl
